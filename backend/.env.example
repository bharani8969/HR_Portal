NODE_ENV=development
PORT=5000
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/hrms
# One or more allowed browser origins, comma separated. Two entries let you test two logins side by side
# (http://localhost:5173 and http://127.0.0.1:5173 keep separate login cookies).
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# White-label branding used in emails and the authenticator app (set per client)
CLIENT_NAME=HRS Tech
APP_NAME=PeopleVault
POWERED_BY=TREZION Technology
APP_TAGLINE=Employee Records, Securely Kept
BRAND_PRIMARY=#2F6BFF
BRAND_ACCENT=#18D5C8
BRAND_DARK=#0B1F4B
# Optional same-site logo path, e.g. /client-logo.svg (file must exist in the served site). Empty = generated monogram.
CLIENT_LOGO_URL=
# Where concerns sent from the "Powered by" contact form are delivered
CONCERN_TO_EMAIL=bharani7576@gmail.com
SESSION_COOKIE_NAME=hrms_session
# true whenever the site is served over HTTPS (default: true when NODE_ENV=production)
COOKIE_SECURE=false
# Many users (and one user on many devices) can be signed in at once. Absolute limit / idle limit:
SESSION_TTL_MINUTES=480
SESSION_IDLE_TIMEOUT_MINUTES=60

# Dev-only data key (32 random bytes, base64). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production: unwrap this through your cloud KMS instead of keeping it in env.
DATA_ENCRYPTION_KEY=

# Two-step (authenticator app) login. false = Admin signs in with email + password only (optional MFA still available on the Security page).
REQUIRE_ADMIN_MFA=false

# Documents: local = dev only (blocked in production). db = encrypted inside the SQL database (no extra service; keep files small).
# s3 = private bucket (AWS, Cloudflare R2, Backblaze B2).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-private
OBJECT_STORAGE_BUCKET=private-hrms-documents
OBJECT_STORAGE_REGION=ap-south-1
# S3-compatible providers (Cloudflare R2 / Backblaze B2): fill these and set STORAGE_DRIVER=s3. R2 region = auto.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
MAX_FILE_MB=5

# Malware scanning: dev = EICAR test-string check only (blocked in production). clamav = clamd over TCP.
SCAN_DRIVER=dev
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Email: console prints links in the server log (dev).
# resend = Resend's HTTPS API (recommended; works on Render free, which blocks SMTP). Needs RESEND_API_KEY.
#   Test without a domain: EMAIL_FROM=onboarding@resend.dev (delivers ONLY to the email your Resend account was created with).
#   To email everyone: verify your domain in Resend, then EMAIL_FROM=HR Portal <no-reply@yourdomain.com>
# smtp = any SMTP server through SMTP_URL (blocked on Render free).
EMAIL_DRIVER=console
RESEND_API_KEY=
SMTP_URL=
EMAIL_FROM=PeopleVault <no-reply@example.com>

# Used only by `npm run seed` (synthetic data; change immediately)
ADMIN_EMAIL=ceo@example.com
ADMIN_PASSWORD=ChangeMe-Str0ng-Passw0rd!
