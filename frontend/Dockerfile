FROM node:22-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_CLIENT_NAME
ARG VITE_APP_NAME
ARG VITE_APP_TAGLINE
ARG VITE_POWERED_BY
ARG VITE_BRAND_PRIMARY
ARG VITE_BRAND_ACCENT
ARG VITE_BRAND_DARK
ARG VITE_CLIENT_LOGO
ENV VITE_CLIENT_NAME=$VITE_CLIENT_NAME VITE_APP_NAME=$VITE_APP_NAME VITE_APP_TAGLINE=$VITE_APP_TAGLINE VITE_POWERED_BY=$VITE_POWERED_BY VITE_BRAND_PRIMARY=$VITE_BRAND_PRIMARY VITE_BRAND_ACCENT=$VITE_BRAND_ACCENT VITE_BRAND_DARK=$VITE_BRAND_DARK VITE_CLIENT_LOGO=$VITE_CLIENT_LOGO
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
